{
    "description": "L2 背景交通参数先验；权威协议为 config/paper_camera_ready_manifest.json",
    "canonical_manifest": "config/paper_camera_ready_manifest.json",
    "l1_frozen_source": {
        "path_pattern": "data/camera_ready_revision_20260716/l1/seed-{seed}/selected.json",
        "seeds": [0, 1, 2, 3, 4],
        "selection_field": "selected_for_l2",
        "method": "BO"
    },
    "observation_contract": {
        "frozen_index": "data/calibration/l2_observation_vector_corridor_M11.csv",
        "raw_d2d_dimension": 11,
        "moving_only_dimension": 5,
        "moving_only_observation_ids": [1, 2, 5, 7, 22]
    },
    "parameters": [
        {
            "name": "capacityFactor",
            "mu": 1.5,
            "sigma": 0.8,
            "min": 0.3,
            "max": 3.0,
            "scope": "global",
            "sumo_attribute": "SUMO --scale for background demand",
            "description": "背景交通需求缩放因子"
        },
        {
            "name": "minGap_background",
            "mu": 2.5,
            "sigma": 0.5,
            "min": 0.5,
            "max": 5.0,
            "scope": "background_vtype",
            "sumo_attribute": "vType minGap",
            "description": "背景车辆最小跟车间距，控制拥堵时排队密度"
        },
        {
            "name": "impatience",
            "mu": 0.5,
            "sigma": 0.2,
            "min": 0.0,
            "max": 1.0,
            "scope": "background_vtype",
            "sumo_attribute": "vType impatience",
            "description": "不耐烦程度，控制拥堵时变道积极性"
        }
    ],
    "ensemble_config": {
        "ensemble_size": 10,
        "max_iterations": 3,
        "initial_damping": 0.3,
        "damping_mode": "fixed",
        "adaptive_damping": false,
        "localization": null,
        "observation_noise_std": 10.0,
        "observation_variance_floor": 1.0,
        "ensemble_seed_schedule": "10000*seed + 100*iteration",
        "sumo_seed_schedule": "200000 + 10000*seed + 100*iteration + member"
    }
}
